[Unit]
Description=FPV RC Car camera publisher to MediaMTX
After=network-online.target mediamtx.service
Wants=network-online.target mediamtx.service

[Service]
Type=simple
User=pi
WorkingDirectory=/opt/fpv-car
EnvironmentFile=-/opt/fpv-car/video.env
Environment=FPV_SYSTEMD=1
ExecStart=/bin/bash /opt/fpv-car/scripts/start_video_mediamtx.sh
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
