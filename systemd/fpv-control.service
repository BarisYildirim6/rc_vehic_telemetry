[Unit]
Description=FPV RC Car FastAPI control backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/opt/fpv-car
Environment=FPV_CONFIG=/opt/fpv-car/config.yaml
ExecStart=/opt/fpv-car/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target

